#include <windows.h>

#define RT_MANIFEST 24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,7,8
PRODUCTVERSION  0,1,7,8
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MyOpenKey"
            VALUE "FileDescription", "MyOpenKey Vietnamese Input Method"
            VALUE "FileVersion", "0.1.07"
            VALUE "InternalName", "MyOpenKey"
            VALUE "LegalCopyright", "GPLv3"
            VALUE "OriginalFilename", "MyOpenKey.exe"
            VALUE "ProductName", "MyOpenKey"
            VALUE "ProductVersion", "0.1.07"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
